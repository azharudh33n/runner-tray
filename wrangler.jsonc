// The website at https://runnertray.wx8.org/ : a Cloudflare Worker (site-worker/index.js) in front of
// the static site in _site. The Worker adds /download, /download/portable and /api/latest, and sends
// http:// to https://. Build _site first with tools/build-site.ps1, then `npx wrangler deploy`.
// The Website workflow does both on every push to main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runnertray-site",
  "main": "site-worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "runnertray.wx8.org", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
