// The website at https://wx8.org/ : a static Cloudflare Worker that serves _site.
// Build _site first with tools/build-site.ps1, then deploy with `npx wrangler deploy`.
// The Website workflow does both on every push to main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runnertray-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "wx8.org", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
