<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>RunnerTray</AssemblyName>
    <RootNamespace>RunnerTray</RootNamespace>
    <Product>RunnerTray</Product>
    <Description>GitHub Actions runs and self-hosted runners in your Windows system tray.</Description>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunnerTray.Core\RunnerTray.Core.csproj" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
